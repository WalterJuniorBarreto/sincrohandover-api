# =========================================================================
# SincroHandover: Backend .gitignore (Spring Boot / Java)
# =========================================================================

# Compiled class files
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven / Gradle build directories
/target/
/build/
!/.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Entornos de desarrollo locales (IDEs)
.idea/
*.iml
*.iws
.vscode/
.settings/
.classpath
.project
.springBeans

# Credenciales y configuraciones sensibles (Evitar fugas en la nube)
application-local.yml
application-local.properties
.env
.env.local
secrets.yml

# Sistema Operativo
.DS_Store
Thumbs.db
